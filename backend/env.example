# Copy this file to ".env" (same folder) and fill in your values. Never commit .env.
# Cloud hosting: set DATABASE_URL instead of the DB_* lines below (it takes priority).
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=postgres
DB_PASSWORD=your_password_here
# The synthetic data was generated "as of" this date. Remove the line to use today's date.
AS_OF_DATE=2026-10-30
# Comma-separated front-end origins allowed to call this API (browser CORS).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional regex for generated preview domains, for example: https://.*\.lovable\.app
# CORS_ORIGIN_REGEX=
# Optional: path to the saved quantity model (default: ../ml/artifacts/quantity_model_v1.json)
# QUANTITY_MODEL_PATH=
# Required in production: a long random string used to sign login tokens (generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))" )
JWT_SECRET=
# Login session length in minutes (default 480)
# ACCESS_TOKEN_MINUTES=480
